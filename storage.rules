rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 공급사 온보딩 파일 (사업자등록증, 통장사본, 상품정보 등)
    match /supplier-onboarding/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
    // 셀러 온보딩 파일
    match /seller-onboarding/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
    // 셀러 제안서 파일 (엑셀 등 포함)
    match /seller-proposals/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }
    // 공급사 제안서 파일 (엑셀 등 포함)
    match /supplier-proposals/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }
    // 셀러 서류 (신분증, 통장, 사업자등록증)
    match /seller-documents/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
    // 기본: 나머지 경로 접근 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
